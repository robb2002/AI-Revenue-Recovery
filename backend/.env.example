DATABASE_URL=postgresql://postgres.<ref>:<password>@<pooler-host>:5432/postgres
CLERK_SECRET_KEY=sk_test_...
CORS_ALLOWED_ORIGINS=http://localhost:5173
DEMO_AS_OF_DATE=2026-11-04
APP_ENV=local
LOG_LEVEL=INFO

# Azure OpenAI (same as Sales Intelligence)
LLM_PROVIDER=azure_openai
LLM_API_KEY=
LLM_MODEL=interns-gpt-4.1
LLM_TIMEOUT_SECONDS=60
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Embeddings — same Azure deployment as parent Sales Intelligence app
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SIMILARITY_GATE=0.72
EMBEDDING_TIMEOUT_SECONDS=15
RETRIEVAL_TOP_K=5
